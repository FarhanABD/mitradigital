# Database Connection URL (Serverless PostgreSQL - Neon / Supabase)
# Contoh format: postgresql://username:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/mitradigital?sslmode=require"

# Resend API Key untuk notifikasi email gratis (Daftar di resend.com)
RESEND_API_KEY="re_123456789"

# Email Admin penampung pesan kontak
ADMIN_EMAIL="admin@mitradigital.id"
