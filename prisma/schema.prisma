datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ContactLead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  serviceType String?
  budgetRange String?
  message     String
  status      String   @default("NEW") // NEW, IN_PROGRESS, CONTACTED, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EstimateSubmission {
  id              String   @id @default(cuid())
  clientName      String?
  clientEmail     String?
  clientPhone     String?
  selectedOptions Json     // Menyimpan opsi fitur yang dipilih
  estimatedPrice  Int
  estimatedDays   Int
  createdAt       DateTime @default(now())
}

model Project {
  id            String   @id @default(cuid())
  title         String
  category      String
  categoryLabel String
  description   String
  client        String
  technologies  String[]
  image         String
  images        String[]
  stats         Json?
  liveUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
